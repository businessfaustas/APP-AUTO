{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site served from Workers static assets. Name must match the Cloudflare project name.
  "name": "app-auto",
  "compatibility_date": "2026-09-30",
  // Files are served first; requests that match no file (only /api/*) run worker.js.
  "main": "worker.js",
  // Public URL: https://app-auto.business-faustas.workers.dev
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Any URL without a file gets the branded 404.html (with a real 404 status)
    "not_found_handling": "404-page"
  }
  // /admin upload page → commits to this repo/branch (the branch Cloudflare publishes from).
  "vars": { "GITHUB_REPO": "businessfaustas/APP-AUTO", "GITHUB_BRANCH": "claude/compassionate-edison-m3odyu" },
  // Secrets for the upload page (set in the dashboard, never here): ADMIN_PASSWORDS ("Name:password,Name2:password2")
  // and GITHUB_TOKEN (fine-grained token, Contents: read and write on this repo). See README → "Upload page".
  // Secret for live payments (never put it in this file):
  //   Cloudflare dashboard → Workers → app-auto → Settings → Variables and secrets → STRIPE_SECRET_KEY
}
